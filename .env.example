# Broker mode: "simulator" (built-in paper simulator) or "ibkr" (TWS / IB Gateway)
BROKER_MODE=simulator

# IBKR TWS / IB Gateway connection settings
# Default ports: TWS Paper=7497, TWS Live=7496, Gateway Paper=4002, Gateway Live=4001
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Safety switch: must be explicitly set to true to allow live ports (7496 / 4001)
ALLOW_LIVE_TRADING=false

# Risk Guardrails
MAX_ORDER_QTY=500
MAX_ORDER_NOTIONAL=50000.0
MAX_POSITION_SHARES=1000
MAX_DAILY_LOSS=5000.0

# Watchlist symbols (comma-separated)
DEFAULT_WATCHLIST=SPY,QQQ,IWM,TLT,GLD,AAPL,MSFT,NVDA,AMZN,META,AMD

# SQLite database path & US market-hours bot guard
DB_PATH=data/trading.db
ENFORCE_MARKET_HOURS=true

# Optional Gemini API key for LLM-powered NewsGuard rationale (falls back to keywords if unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
NEWS_GUARD_USE_LLM=true

